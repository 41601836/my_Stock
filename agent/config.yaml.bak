backtest:
  full_weeks: 208
  quick_weeks: 104
  top_n_stocks: 10
  transaction_cost: 0.0015
factors:
  base_pool:
  - turnover_rate
  - volatility_10d
  - volatility_20d
  - volatility_60d
  - volatility_120d
  - skewness_20d
  - pb
  custom_new_factors:
  - excess_return_20d
  - max_drawdown_20d
  - north_net_inflow_ratio
  - vol_ratio
  experimental_pool:
  - return_10d
  - return_120d
  - volatility_10d
  - volatility_120d
  - max_drawdown_60d
  - turnover_rate_5d
  - turnover_rate_20d
  - vol_ratio
  - beta_60d
  - quality_score
  - low_turnover_flag
  - timeliness_decay
  # v3.1 新增实验因子
  - overnight_return_5d
  - intraday_return_5d
  - amihud_illiq_20d
  - gk_volatility_20d
  - parkinson_volatility_20d
  - turnover_volatility_20d
  - volume_skewness_20d
risk_control:
  dark_mode_beta_limit: 1.2
  extreme_market_threshold: -0.045
  min_effective_width: 2
  prediction_error_threshold: -0.02
  timeliness_half_life_days: 3
special_boost:
  factors:
  - volatility_10d
  - volatility_120d
  multiplier: 1.32
validation:
  baseline_end_date: '20241231'
  baseline_start_date: '20200102'
  decay_invalid_threshold: 0.5
  decay_warning_threshold: 0.3
  recent_weeks_lookback: 52
# P1-3 巡航跨 top_n 稳健性闸门（2026-09-03 复盘新增）
# 背景：20260903 巡航轨迹 66 格点 / 22 组合中，旧报告最优 combo10 仅 top_n=10/20 超额卡玛为正
#   （+0.1977 / +0.0063），top_n=30 为 -0.0495；全样本 0 个组合三档全正 —— 单点最优是容量敏感的脆弱结果。
# 规则：同一因子组合在三档 top_n(10/20/30) 的超额卡玛「最小值」需 ≥ min_excess_calmar，
#   才可进入全局最优评选 / 达标部署 / 续跑历史最优种子。
# 回滚：enabled 改 false 即完全恢复旧行为（单点最优即可部署）。
cruise:
  robustness_gate:
    enabled: true
    min_excess_calmar: 0.0
